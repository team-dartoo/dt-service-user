SPRING_APPLICATION_NAME=dt-service-user
SPRING_PROFILES_ACTIVE=local
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SHUTDOWN_TIMEOUT=30s
SPRING_DATASOURCE_DRIVER_CLASS_NAME=mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_TIME_ZONE=UTC
SPRING_JACKSON_TIME_ZONE=UTC

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=Dartoo

DB_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
DB_USERNAME=
DB_PASSWORD=
HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=
JWT_REFRESH_PEPPER=

OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINK_SECRET=
OAUTH_LINK_TTL_SECONDS=

SECURITY_LOG_LEVEL=
APP_LOG_LEVEL=