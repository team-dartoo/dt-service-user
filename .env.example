SPRING_APPLICATION_NAME=dt-service-user
SPRING_PROFILES_ACTIVE=local
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SHUTDOWN_TIMEOUT=30s
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_TIME_ZONE=UTC
SPRING_JACKSON_TIME_ZONE=UTC

POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=Dartoo

DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DB_USERNAME=
DB_PASSWORD=
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=
JWT_REFRESH_PEPPER=

OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINK_SECRET=
OAUTH_LINK_TTL_SECONDS=

CORS_ALLOWED_ORIGINS=
# 리스트 형식으로 작성 가능 ex) CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

SECURITY_LOG_LEVEL=
APP_LOG_LEVEL=

WORKER_API_KEY=your-worker-api-key-here